{
  "name": "pure-react-carousel",
  "version": "3.3.1",
  "description": "A minimal dependency, highly customizable, carousel component for React.",
  "keywords": [
    "accessible",
    "aria",
    "carousel",
    "image",
    "react",
    "slider",
    "typescript",
    "zoom"
  ],
  "homepage": "https://express-labs.github.io/pure-react-carousel/",
  "bugs": {
    "url": "https://github.com/express-labs/pure-react-carousel/issues"
  },
  "license": "MIT",
  "author": "Matthewumble, Matthew Toledo, Express",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/express-labs/pure-react-carousel.git"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/types/index.d.ts",
  "typings": "dist/types/index.d.ts",
  "scripts": {
    "build": "vp pack && npm run build:types",
    "build:demo": "vp build",
    "build:types": "tsc -p tsconfig.build.json",
    "format": "vp fmt --write src dev typings vite.config.ts",
    "format:check": "vp fmt --check src dev typings vite.config.ts",
    "lint": "vp lint src dev typings vite.config.ts",
    "lint:fix": "vp lint --fix src dev typings vite.config.ts",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build",
    "start": "vp dev",
    "test": "vp test run --coverage",
    "test:compat": "node scripts/react-compat/index.mjs",
    "test:compat:demo": "node scripts/react-compat/index.mjs --update-demo",
    "test:compat:fast": "node scripts/react-compat/index.mjs --skip-vitest",
    "test:compat:report": "node scripts/react-compat/index.mjs --report-only",
    "test:watch": "vp test",
    "typecheck": "npm run build:types && tsc --noEmit && tsc -p tsconfig.consumer.json --noEmit",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitest/coverage-v8": "5.0.5",
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.1.1",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "postcss-modules": "^4.3.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sass": "^1.92.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
