{
  "name": "pure-react-carousel",
  "version": "3.0.0",
  "description": "A minimal dependency, highly customizable, carousel component for React.",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "typings": "typings/index.d.ts",
  "types": "typings/index.d.ts",
  "files": [
    "dist",
    "typings"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run build:es && npm run build:cjs",
    "build:cjs": "rollup -c rollup.config.cjs.mjs",
    "build:es": "rollup -c rollup.config.es.mjs",
    "format": "oxfmt --write src typings",
    "format:check": "oxfmt --check src typings",
    "lint": "oxlint src typings",
    "lint:fix": "oxlint --fix src typings",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/express-labs/pure-react-carousel.git"
  },
  "keywords": [
    "react",
    "carousel",
    "image",
    "zoom",
    "slider",
    "aria",
    "accessible",
    "typescript"
  ],
  "author": "Matthewumble, Matthew Toledo, Express",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/express-labs/pure-react-carousel/issues"
  },
  "homepage": "https://express-labs.github.io/pure-react-carousel/",
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "cssnano": "^7.1.1",
    "jsdom": "^27.0.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.6",
    "postcss-modules": "^4.3.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rollup": "^4.62.2",
    "sass": "^1.92.1",
    "terser": "^5.48.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
